{"cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# 🤖 Notebook 2: Modeling & Submission\n", "\n", "> **Titanic - Machine Learning from Disaster**\n", "\n", "This notebook covers:\n", "1. Model training loop with cross-validation\n", "2. Cross-validation results comparison table\n", "3. Feature importance plots (tree-based models)\n", "4. Confusion matrix & ROC curves\n", "5. Final submission generation\n", "\n", "---\n", "\n", "**Prerequisite**: Run `01_eda_and_feature_engineering.ipynb` first."]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 1: Imports & Setup\n", "import numpy as np\n", "import pandas as pd\n", "import matplotlib.pyplot as plt\n", "import seaborn as sns\n", "import warnings\n", "import joblib\n", "import sys\n", "\n", "from sklearn.model_selection import StratifiedKFold, cross_val_score, GridSearchCV, train_test_split\n", "from sklearn.preprocessing import StandardScaler\n", "from sklearn.metrics import (\n", "    accuracy_score, precision_score, recall_score, f1_score,\n", "    roc_auc_score, confusion_matrix, classification_report, roc_curve, auc\n", ")\n", "\n", "warnings.filterwarnings('ignore')\n", "sys.path.insert(0, '..')\n", "\n", "# Plot settings\n", "plt.style.use('seaborn-v0_8-whitegrid')\n", "plt.rcParams['figure.figsize'] = (12, 6)\n", "plt.rcParams['font.size'] = 11\n", "\n", "print(\"✅ Libraries imported successfully\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 2: Load & Prepare Data\n", "from src.data_loader import load_train_test\n", "from src.preprocessor import TitanicPreprocessor\n", "from src.feature_engineering import FeatureEngineer\n", "\n", "DATA_DIR = '../data'\n", "RANDOM_STATE = 42\n", "TEST_SIZE = 0.2\n", "CV_FOLDS = 5\n", "\n", "# Load raw data\n", "train_df, test_df = load_train_test(DATA_DIR, backend='pandas')\n", "print(f\"📦 Train: {train_df.shape}, Test: {test_df.shape}\")\n", "\n", "# Feature engineering\n", "engineer = FeatureEngineer(create_interactions=True)\n", "train_df = engineer.transform(train_df.copy())\n", "test_df = engineer.transform(test_df.copy())\n", "\n", "# Preprocessing\n", "preprocessor = TitanicPreprocessor()\n", "train_processed = preprocessor.fit_transform(train_df.copy())\n", "test_processed = preprocessor.transform(test_df.copy())\n", "\n", "# Get feature columns for modeling\n", "exclude = {'PassengerId', 'Survived', 'Name', 'Ticket', 'Cabin'}\n", "feature_cols = [c for c in preprocessor.get_feature_names(train_df) if c not in exclude]\n", "feature_cols = [c for c in feature_cols if c in train_processed.columns]\n", "\n", "X = train_processed[feature_cols].select_dtypes(include=[np.number]).fillna(0)\n", "y = train_processed['Survived'].astype(int)\n", "\n", "# Train/Validation split\n", "X_train, X_val, y_train, y_val = train_test_split(\n", "    X, y, test_size=TEST_SIZE, random_state=RANDOM_STATE, stratify=y\n", ")\n", "\n", "# Scale features\n", "scaler = StandardScaler()\n", "X_train_scaled = scaler.fit_transform(X_train)\n", "X_val_scaled = scaler.transform(X_val)\n", "\n", "print(f\"\\n📊 Features: {len(feature_cols)}\")\n", "print(f\"📊 Train: {X_train_scaled.shape}, Val: {X_val_scaled.shape}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 3: Define Models to Train\n", "from src.models import get_model, get_param_grid, get_available_models\n", "\n", "model_names = get_available_models()\n", "print(f\"Models to train ({len(model_names)}):\")\n", "for name in model_names:\n", "    print(f\"  • {name}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 4: Training Loop — Cross-Validation for All Models\n", "cv = StratifiedKFold(n_splits=CV_FOLDS, shuffle=True, random_state=RANDOM_STATE)\n", "\n", "results = []\n", "trained_models = {}\n", "\n", "print(\"=\" * 70)\n", "print(\"TRAINING LOOP — Cross-Validation Results\")\n", "print(\"=\" * 70)\n", "\n", "for model_name in model_names:\n", "    try:\n", "        # Get model and param grid\n", "        model = get_model(model_name, random_state=RANDOM_STATE)\n", "        param_grid = get_param_grid(model_name)\n", "\n", "        # GridSearchCV with reduced params for speed\n", "        small_grid = {k: v[:2] if len(v) > 2 else v for k, v in param_grid.items()}\n", "\n", "        grid_search = GridSearchCV(\n", "            estimator=model,\n", "            param_grid=small_grid,\n", "            cv=cv,\n", "            scoring='accuracy',\n", "            n_jobs=-1,\n", "            verbose=0,\n", "            return_train_score=True,\n", "        )\n", "\n", "        print(f\"\\n▶ Training {model_name}...\")\n", "        grid_search.fit(X_train_scaled, y_train)\n", "\n", "        best_model = grid_search.best_estimator_\n", "        best_params = grid_search.best_params_\n", "        best_cv_score = grid_search.best_score_\n", "\n", "        # Validation metrics\n", "        val_preds = best_model.predict(X_val_scaled)\n", "        try:\n", "            val_proba = best_model.predict_proba(X_val_scaled)[:, 1]\n", "            val_auc = roc_auc_score(y_val, val_proba)\n", "        except:\n", "            val_auc = None\n", "\n", "        result = {\n", "            'Model': model_name,\n", "            'CV Accuracy': round(best_cv_score, 4),\n", "            'Val Accuracy': round(accuracy_score(y_val, val_preds), 4),\n", "            'Precision': round(precision_score(y_val, val_preds, zero_division=0), 4),\n", "            'Recall': round(recall_score(y_val, val_preds, zero_division=0), 4),\n", "            'F1': round(f1_score(y_val, val_preds, zero_division=0), 4),\n", "            'ROC-AUC': round(val_auc, 4) if val_auc else 'N/A',\n", "            'Best Params': str(best_params),\n", "        }\n", "        results.append(result)\n", "        trained_models[model_name] = best_model\n", "\n", "        print(f\"  ✅ CV Acc={best_cv_score:.4f}, Val Acc={result['Val Accuracy']:.4f}, \"\n", "              f\"F1={result['F1']:.4f}, AUC={result['ROC-AUC']}\")\n", "\n", "    except Exception as e:\n", "        print(f\"  ❌ {model_name} failed: {e}\")\n", "        results.append({\n", "            'Model': model_name, 'CV Accuracy': 'ERROR', 'Val Accuracy': 'ERROR',\n", "            'Precision': 'ERROR', 'Recall': 'ERROR', 'F1': 'ERROR',\n", "            'ROC-AUC': 'ERROR', 'Best Params': str(e)\n", "        })"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 5: Cross-Validation Results Comparison Table\n", "results_df = pd.DataFrame(results)\n", "results_df = results_df.sort_values('Val Accuracy', ascending=False).reset_index(drop=True)\n", "\n", "print(\"\\n\" + \"=\" * 80)\n", "print(\"MODEL COMPARISON TABLE (sorted by Validation Accuracy)\")\n", "print(\"=\" * 80)\n", "display_cols = ['Model', 'CV Accuracy', 'Val Accuracy', 'Precision', 'Recall', 'F1', 'ROC-AUC']\n", "print(results_df[display_cols].to_string(index=False))\n", "print(\"\\n\" + \"=\" * 80)\n", "\n", "# Identify best model\n", "best_model_name = results_df.iloc[0]['Model']\n", "best_model = trained_models.get(best_model_name)\n", "print(f\"\\n🏆 Best Model: {best_model_name}\")\n", "print(f\"   Val Accuracy: {results_df.iloc[0]['Val Accuracy']}\")\n", "print(f\"   F1 Score:     {results_df.iloc[0]['F1']}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 6: Visualize Model Comparison — Bar Chart\n", "fig, ax = plt.subplots(figsize=(14, 6))\n", "\n", "# Filter out error rows\n", "plot_df = results_df[results_df['Val Accuracy'] != 'ERROR'].copy()\n", "plot_df['Val Accuracy'] = plot_df['Val Accuracy'].astype(float)\n", "plot_df['CV Accuracy'] = plot_df['CV Accuracy'].astype(float)\n", "\n", "x = np.arange(len(plot_df))\n", "width = 0.35\n", "\n", "bars1 = ax.bar(x - width/2, plot_df['CV Accuracy'], width, label='CV Accuracy', \n", "                color='#3498db', alpha=0.8)\n", "bars2 = ax.bar(x + width/2, plot_df['Val Accuracy'], width, label='Val Accuracy', \n", "                color='#2ecc71', alpha=0.8)\n", "\n", "ax.set_xlabel('Model', fontsize=12)\n", "ax.set_ylabel('Accuracy Score', fontsize=12)\n", "ax.set_title('Model Performance Comparison\\n(Cross-Validation vs Validation)', \n", "              fontsize=14, fontweight='bold')\n", "ax.set_xticks(x)\n", "ax.set_xticklabels(plot_df['Model'], rotation=30, ha='right')\n", "ax.legend(loc='lower right')\n", "ax.set_ylim(0.6, 1.0)\n", "ax.axhline(y=0.80, color='red', linestyle='--', alpha=0.7, label='Target ≥ 80%')\n", "ax.grid(axis='y', alpha=0.3)\n", "\n", "# Add value labels on bars\n", "for bar in bars1:\n", "    height = bar.get_height()\n", "    ax.text(bar.get_x() + bar.get_width()/2., height + 0.005,\n", "            f'{height:.3f}', ha='center', va='bottom', fontsize=9)\n", "for bar in bars2:\n", "    height = bar.get_height()\n", "    ax.text(bar.get_x() + bar.get_width()/2., height + 0.005,\n", "            f'{height:.3f}', ha='center', va='bottom', fontsize=9)\n", "\n", "plt.tight_layout()\n", "plt.show()"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 7: Feature Importance Plot (Tree-based Models)\n", "fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n", "\n", "tree_models = {\n", "    'Random Forest': trained_models.get('random_forest'),\n", "    'Gradient Boosting': trained_models.get('gradient_boosting'),\n", "}\n", "\n", "# Add optional models if available\n", "if 'xgboost' in trained_models:\n", "    tree_models['XGBoost'] = trained_models['xgboost']\n", "if 'lightgbm' in trained_models:\n", "    tree_models['LightGBM'] = trained_models['lightgbm']\n", "\n", "for idx, (name, model) in enumerate(tree_models.items()):\n", "    if idx >= 3:\n", "        break\n", "    if model is None or not hasattr(model, 'feature_importances_'):\n", "        continue\n", "    importances = model.feature_importances_\n", "    indices = np.argsort(importances)[::-1][:15]  # Top 15 features\n", "\n", "    ax = axes[idx]\n", "    feature_names_plot = [feature_cols[i] if i < len(feature_cols) else f'feat_{i}' \n", "                        for i in indices]\n", "    ax.barh(range(len(indices)), importances[indices], color='#e74c3c', alpha=0.8)\n", "    ax.set_yticks(range(len(indices)))\n", "    ax.set_yticklabels(feature_names_plot, fontsize=10)\n", "    ax.invert_yaxis()\n", "    ax.set_title(f'{name}\\nTop 15 Feature Importances', fontsize=12, fontweight='bold')\n", "    ax.set_xlabel('Importance')\n", "\n", "# Hide unused subplots\n", "for idx in range(len(tree_models), 3):\n", "    axes[idx].set_visible(False)\n", "\n", "plt.suptitle('Feature Importance Analysis (Tree-based Models)', \n", "             fontsize=15, fontweight='bold', y=1.02)\n", "plt.tight_layout()\n", "plt.show()"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 8: Confusion Matrix for Best Model\n", "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n", "\n", "val_preds_best = best_model.predict(X_val_scaled)\n", "cm = confusion_matrix(y_val, val_preds_best)\n", "\n", "# Confusion Matrix Heatmap\n", "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', \n", "            xticklabels=['Did Not Survive', 'Survived'],\n", "            yticklabels=['Did Not Survive', 'Survived'],\n", "            ax=axes[0], annot_kws={'size': 16})\n", "axes[0].set_title(f'Confusion Matrix\\n({best_model_name})', fontsize=13, fontweight='bold')\n", "axes[0].set_ylabel('True Label')\n", "axes[0].set_xlabel('Predicted Label')\n", "\n", "# Classification Report as heatmap\n", "report_dict = classification_report(y_val, val_preds_best, output_dict=True)\n", "report_df = pd.DataFrame(report_dict).iloc[:-1, :].T  # Exclude avg row\n", "sns.heatmap(report_df[['precision', 'recall', 'f1-score']].astype(float), \n", "            annot=True, fmt='.3f', cmap='RdYlGn', ax=axes[1])\n", "axes[1].set_title('Classification Report', fontsize=13, fontweight='bold')\n", "\n", "plt.suptitle(f'Model Evaluation: {best_model_name}', fontsize=15, fontweight='bold', y=1.02)\n", "plt.tight_layout()\n", "plt.show()"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 9: ROC Curves for All Models\n", "fig, ax = plt.subplots(figsize=(10, 8))\n", "\n", "colors = ['#e74c3c', '#3498db', '#2ecc71', '#f39c12', '#9b59b6', '#1abc9c']\n", "\n", "for idx, (name, model) in enumerate(trained_models.items()):\n", "    if model is None:\n", "        continue\n", "    try:\n", "        y_proba = model.predict_proba(X_val_scaled)[:, 1]\n", "        fpr, tpr, _ = roc_curve(y_val, y_proba)\n", "        roc_auc_val = auc(fpr, tpr)\n", "        ax.plot(fpr, tpr, color=colors[idx % len(colors)], lw=2,\n", "                label=f'{name} (AUC = {roc_auc_val:.3f})')\n", "    except Exception:\n", "        pass\n", "\n", "# Random baseline\n", "ax.plot([0, 1], [0, 1], color='gray', lw=1, linestyle='--', label='Random (AUC = 0.500)')\n", "\n", "ax.set_xlim([0.0, 1.0])\n", "ax.set_ylim([0.0, 1.05])\n", "ax.set_xlabel('False Positive Rate', fontsize=12)\n", "ax.set_ylabel('True Positive Rate', fontsize=12)\n", "ax.set_title('ROC Curves — All Models', fontsize=14, fontweight='bold')\n", "ax.legend(loc='lower right', fontsize=10)\n", "ax.grid(alpha=0.3)\n", "\n", "plt.tight_layout()\n", "plt.show()"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 📤 Submission Generation\n", "\n", "Now we'll generate predictions on the test set and create a Kaggle submission file."]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 10: Generate Predictions on Test Set\n", "# Prepare test features (same columns as training)\n", "X_test = test_processed[feature_cols].select_dtypes(include=[np.number]).fillna(0)\n", "\n", "# Align columns with training data\n", "missing_cols = set(X_train.columns) - set(X_test.columns)\n", "extra_cols = set(X_test.columns) - set(X_train.columns)\n", "for col in missing_cols:\n", "    X_test[col] = 0\n", "X_test = X_test[X_train.columns]\n", "\n", "# Scale using fitted scaler\n", "X_test_scaled = scaler.transform(X_test)\n", "\n", "# Generate predictions\n", "predictions = best_model.predict(X_test_scaled).astype(int)\n", "\n", "# Create submission DataFrame\n", "submission = pd.DataFrame({\n", "    'PassengerId': test_processed['PassengerId'].values.astype(int),\n", "    'Survived': predictions\n", "})\n", "\n", "print(f\"\\n📤 Submission shape: {submission.shape}\")\n", "print(f\"   Predicted survived: {submission['Survived'].sum()} / {len(submission)}\")\n", "print(f\"   Survival rate:      {submission['Survived'].mean():.4f} ({submission['Survived'].mean()*100:.1f}%)\")\n", "print(f\"\\n⚠️  Expected survival rate ~38% (matches training distribution)\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 11: Save Submission File & Model\n", "import os\n", "output_dir = '../outputs'\n", "os.makedirs(output_dir, exist_ok=True)\n", "\n", "# Save submission CSV\n", "submission_path = os.path.join(output_dir, 'submission.csv')\n", "submission.to_csv(submission_path, index=False)\n", "print(f\"✅ Saved submission to: {submission_path}\")\n", "\n", "# Preview submission\n", "print(f\"\\n📄 Submission preview (first 15 rows):\")\n", "print(submission.head(15).to_string(index=False))\n", "\n", "# Validate format matches Kaggle requirements\n", "assert list(submission.columns) == ['PassengerId', 'Survived'], \\\n", "       \"❌ Column names must be ['PassengerId', 'Survived']\"\n", "assert submission['Survived'].dtype in [int, np.int64, np.int32], \\\n", "       \"❌ Survived column must be integer type\"\n", "assert len(submission) == len(test_df), \\\n", "       f\"❌ Row count mismatch: {len(submission)} != {len(test_df)}\"\n", "print(f\"\\n✅ Submission format validated successfully!\")\n", "\n", "# Save trained model\n", "model_path = os.path.join(output_dir, 'model.pkl')\n", "joblib.dump(best_model, model_path)\n", "print(f\"✅ Saved best model to: {model_path}\")"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Cell 12: Final Summary\n", "print(\"\\n\" + \"=\" * 70)\n", "print(\"TITANIC ML PROJECT — FINAL SUMMARY\")\n", "print(\"=\" * 70)\n", "print(f\"\\n📂 Repository: https://github.com/Scpkeeper/Titanic-Project\")\n", "print(f\"🏆 Best Model:     {best_model_name}\")\n", "print(f"📊 Val Accuracy:   {results_df.iloc[0]['Val Accuracy']}\")\n", "print(f"📊 F1 Score:       {results_df.iloc[0]['F1']}\")\n", "print(f\"📈 ROC-AUC:       {results_df.iloc[0]['ROC-AUC']}\")\n", "print(f\"\\n📁 Output Files:\")\n", "print(f\"   • submission.csv  → {submission_path}\")\n", "print(f\"   • model.pkl        → {model_path}\")\n", "print(f\"\\n📋 Next Steps:\")\n", "print(f\"   1. Upload submission.csv to Kaggle competition\")\n", "print(f\"   2. Check public leaderboard score (target > 0.80)\")\n", "print(f\"   3. If score < 0.80: iterate on features/models\")\n", "print(f\"\\n\" + \"=\" * 70)\n", "print(\"✅ Notebook complete! Good luck on the leaderboard! 🚢\")\n", "print(\"=\" * 70 + \"\\n\")"]}], "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.10.0"}}, "nbformat": 4, "nbformat_minor": 5}
